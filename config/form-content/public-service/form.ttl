@prefix form: <http://lblod.data.gift/vocabularies/forms/>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix mu: <http://mu.semte.ch/vocabularies/core/>.
@prefix displayTypes: <http://lblod.data.gift/display-types/>.
@prefix schema: <http://schema.org/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix nie: <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix ext: <http://mu.semte.ch/vocabularies/ext/>.
@prefix vcard: <http://www.w3.org/2006/vcard/ns#>.
@prefix dcterm: <http://purl.org/dc/terms/> .
@prefix icr: <http://lblod.data.gift/vocabularies/informationclassification/>.
@prefix m8g: <http://data.europa.eu/m8g/>.
@prefix ipdc: <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#>.
@prefix adres: <https://data.vlaanderen.be/ns/adres#>.
@prefix cpsv: <http://purl.org/vocab/cpsv#>.

<http://data.lblod.info/id/lmb/forms/Public-service>
  a form:Form, form:TopLevelForm;
  form:includes ext:titelF,
                ext:beschrijvingF,
                ext:bestuurseenheidClassificatieF,
                ext:bevoegdeOverheidF,
                ext:laatstGewijzigdF,
                ext:typeF,
                ext:proceduresL,
                ext:contactpointsL ;
  sh:group ext:mainPG;
  form:targetType ext:PublicService;
  form:targetLabel dcterm:description;
  form:language "nl";
  ext:prefix <http://data.lblod.info/id/Public-service/>;
  mu:uuid "6293bfe1-40a3-4228-8f33-1f74dc45e2b9".

ext:mainPG
  a form:PropertyGroup;
  sh:name "Public service";
  sh:order 1.

ext:titelF
  a form:Field;
  form:displayType displayTypes:textArea;
  sh:group ext:mainPG;
  sh:name "Titel";
  sh:order 2;
  form:fieldDisabled true;
  sh:path dcterm:title.

ext:beschrijvingF
  a form:Field;
  form:displayType displayTypes:textArea;
  sh:group ext:mainPG;
  sh:name "Beschrijving";
  sh:order 3;
  form:fieldDisabled true;
  sh:path dcterm:description.

ext:bestuurseenheidClassificatieF
  a form:Field;
  form:displayType displayTypes:conceptSchemeMultiSelector;
  sh:group ext:mainPG;
  sh:name "Doelgroep";
  sh:order 4;
  sh:path icr:isRelevantForAdministrativeUnit;
  form:options """{"conceptScheme":"http://data.vlaanderen.be/id/conceptscheme/BestuurseenheidClassificatieCode","orderBy": "http://purl.org/linked-data/cube#order", "searchEnabled":true}""".

ext:bevoegdeOverheidF
  a form:Field;
  form:displayType displayTypes:conceptSchemeMultiSelector;
  sh:group ext:mainPG;
  sh:name "Bevoegde overheid";
  form:fieldDisabled true;
  sh:order 5;
  sh:path m8g:hasCompetentAuthority;
  form:options """{"conceptScheme":"https://productencatalogus.data.vlaanderen.be/id/conceptscheme/IPDCOrganisaties","orderBy": "http://purl.org/linked-data/cube#order", "searchEnabled":true}""".

ext:laatstGewijzigdF
  a form:Field;
  form:displayType displayTypes:dateTime;
  form:fieldDisabled true;
  sh:group ext:mainPG;
  sh:name "Laatst gewijzigd op";
  sh:order 6;
  sh:path schema:dateModified.

ext:typeF
  a form:Field;
  form:displayType displayTypes:conceptSchemeMultiSelector;
  form:fieldDisabled true;
  sh:group ext:mainPG;
  sh:name "Type";
  sh:order 7;
  sh:path dcterm:type;
  form:options """{"conceptScheme":"https://productencatalogus.data.vlaanderen.be/id/conceptscheme/Type","orderBy": "http://purl.org/linked-data/cube#order", "searchEnabled":true}""".

##########################################################
#  Procedures
##########################################################
ext:proceduresPg a form:PropertyGroup;
  sh:name "Procedures";
  sh:order 8.

ext:proceduresPg-sub a form:PropertyGroup;
  sh:name "Procedure";
  sh:order 1.

ext:proceduresS a form:Scope;
  sh:path cpsv:follows .

ext:proceduresL a form:Listing;
  form:each ext:proceduresSf;
  form:scope ext:proceduresS;
  form:createGenerator ext:proceduresG;
  sh:group ext:proceduresPg;
  form:canAdd false;
  form:canRemove false;
  sh:order 1.

ext:proceduresG a form:Generator;
  form:prototype [
    form:shape [
      a cpsv:Rule
    ]
  ];
  form:dataGenerator form:addMuUuid.

ext:proceduresSf a form:SubForm;
  form:includes ext:procedureBeschrijvingF;
  form:includes ext:procedureWebsiteL.

ext:procedureBeschrijvingF a form:Field;
  sh:name "Beschrijving";
  sh:order 1;
  form:fieldDisabled true;
  sh:path dcterm:description;
  form:displayType displayTypes:textArea;
  sh:group ext:proceduresPg-sub.

## Procedure - Website
ext:procedureWebsiteS a form:Scope;
  sh:path ipdc:hasWebsite.

ext:procedureWebsiteL a form:Listing;
  form:each ext:procedureWebsiteSf;
  form:scope ext:procedureWebsiteS;
  sh:group ext:procedureWebsitePg;
  form:canAdd false;
  form:canRemove false;
  sh:order 2.

ext:procedureWebsiteSf a form:SubForm;
  form:includes ext:procedureWebsiteNaamF,
                ext:procedureWebsiteBeschrijvingF,
                ext:procedureWebsiteUrlF.

ext:procedureWebsitePg a form:PropertyGroup;
  sh:order 2.

ext:procedureWebsitePg-sub a form:PropertyGroup;
  sh:name "Website";
  sh:order 1 .

ext:procedureWebsiteNaamF a form:Field;
  form:displayType displayTypes:defaultInput;
  sh:group ext:procedureWebsitePg-sub;
  sh:name "Naam";
  sh:order 1;
  form:fieldDisabled true;
  sh:path dcterm:title.

ext:procedureWebsiteBeschrijvingF a form:Field;
  form:displayType displayTypes:defaultInput;
  sh:group ext:procedureWebsitePg-sub;
  sh:name "Beschrijving";
  sh:order 2;
  form:fieldDisabled true;
  sh:path dcterm:description.

ext:procedureWebsiteUrlF a form:Field;
  form:displayType displayTypes:defaultInput;
  sh:group ext:procedureWebsitePg-sub;
  sh:name "Url";
  sh:order 3;
  form:fieldDisabled true;
  sh:path schema:url.

##########################################################
#  Contactgegevens
##########################################################
ext:contactpointsPg a form:PropertyGroup;
  sh:name "Contactgegevens";
  sh:order 9 .

ext:contactpointsPg-sub a form:PropertyGroup;
  sh:name "Contactpunt";
  sh:order 1 .

ext:contactpointsS a form:Scope;
  sh:path m8g:hasContactPoint .

ext:contactpointsL a form:Listing;
  form:each ext:contactpointsSf;
  form:scope ext:contactpointsS;
  form:createGenerator ext:contactpointsG;
  sh:group ext:contactpointsPg;
  form:canAdd false;
  form:canRemove false;
  sh:order 1.

ext:contactpointsG a form:Generator;
  form:prototype [
    form:shape [
      a schema:ContactPoint
    ]
  ];
  form:dataGenerator form:addMuUuid.

ext:contactpointsSf a form:SubForm;
  form:includes ext:contactPEmailF,
                ext:contactPTelephoneF,
                ext:contactPageF,
                ext:contactPOpeningF,
                ext:contactPointAddressL.

ext:contactPEmailF a form:Field ;
  sh:name "Email";
  sh:order 1;
  form:fieldDisabled true;
  sh:path schema:email;
  form:displayType displayTypes:defaultInput;
  sh:group ext:contactpointsPg-sub.

ext:contactPTelephoneF a form:Field ;
  sh:name "Telefoon";
  sh:order 2;
  form:fieldDisabled true;
  sh:path schema:telephone;
  form:displayType displayTypes:defaultInput;
  sh:group ext:contactpointsPg-sub.

ext:contactPageF a form:Field ;
  sh:name "Website URL";
  sh:order 3;
  form:fieldDisabled true;
  sh:path schema:url;
  form:displayType displayTypes:defaultInput;
  sh:group ext:contactpointsPg-sub.

ext:contactPOpeningF a form:Field;
  sh:name "Openingsuren";
  sh:order 4;
  form:fieldDisabled true;
  sh:path schema:openingHours;
  form:displayType displayTypes:defaultInput;
  sh:group ext:contactpointsPg-sub.

## Contactgegevens - Adres
ext:contactPointAddressS a form:Scope;
  sh:path ipdc:address.

ext:contactPointAddressL a form:Listing;
  form:each ext:contactPointAddressSf;
  form:scope ext:contactPointAddressS;
  sh:group ext:contactPointAddressPg;
  form:canAdd false;
  form:canRemove false;
  sh:maxCount 1;
  sh:order 5.

ext:contactPointAddressSf a form:SubForm;
  form:includes ext:gemeenteF,
                ext:straatF,
                ext:huisnummerF,
                ext:busF,
                ext:postcodeF,
                ext:landF.

ext:contactPointAddressPg a form:PropertyGroup;
  sh:order 5 .

ext:contactPointAddressPg-sub a form:PropertyGroup;
  sh:name "Adres";
  sh:order 1 .

ext:gemeenteF a form:Field;
  form:displayType displayTypes:defaultInput;
  sh:group ext:contactPointAddressPg-sub;
  sh:name "Gemeente";
  sh:order 1;
  form:fieldDisabled true;
  sh:path adres:gemeentenaam.

ext:straatF a form:Field;
  form:displayType displayTypes:defaultInput;
  sh:group ext:contactPointAddressPg-sub;
  sh:name "Straat";
  sh:order 2;
  form:fieldDisabled true;
  sh:path adres:Straatnaam.

ext:huisnummerF a form:Field;
  form:displayType displayTypes:defaultInput;
  sh:group ext:contactPointAddressPg-sub;
  sh:name "Huisnummer";
  sh:order 3;
  form:fieldDisabled true;
  sh:path adres:Adresvoorstelling.huisnummer.

ext:busF a form:Field;
  form:displayType displayTypes:defaultInput;
  sh:group ext:contactPointAddressPg-sub;
  sh:name "Bus";
  sh:order 4;
  form:fieldDisabled true;
  sh:path adres:Adresvoorstelling.busnummer.

ext:postcodeF a form:Field;
  form:displayType displayTypes:defaultInput;
  sh:group ext:contactPointAddressPg-sub;
  sh:name "Postcode";
  sh:order 5;
  form:fieldDisabled true;
  sh:path adres:postcode.

ext:landF a form:Field;
  form:displayType displayTypes:defaultInput;
  sh:group ext:contactPointAddressPg-sub;
  sh:name "Land";
  sh:order 6;
  form:fieldDisabled true;
  sh:path adres:land.
